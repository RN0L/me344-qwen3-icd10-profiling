# syntax=docker/dockerfile:1
# =============================================================================================
# CPU row — hpcc-cluster-39, 32 x86_64 cores, 31 GiB RAM, no accelerator.
#
# Build context is the REPO ROOT:
#   docker build --platform linux/amd64 -f docker/Dockerfile.cpu -t <uri> .
# docker/build.sh does that for you.
#
# This row exists to give the other two a denominator. It runs the identical src/ against the
# identical jax 0.10.2, with the accelerator plugin subtracted — so any gap it shows is
# attributable to hardware rather than to a second implementation of the workload.
#
# The node is x86_64 and this image builds natively there, so it is the cheapest of the three to
# iterate on: build and smoke-test the CPU image first when changing anything shared.
# =============================================================================================

FROM --platform=linux/amd64 python:3.12-slim@sha256:229a2c5bfa27522db7815ea81f9bed70af17ccb9de9fc7ad142b1877b5830d36

COPY --from=ghcr.io/astral-sh/uv:0.11.26 /uv /usr/local/bin/uv

# git: tunix and qwix are git+https SHA requirements.
RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates \
 && rm -rf /var/lib/apt/lists/*

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app/src:/app \
    ME344_EXPECT_BACKEND=cpu

WORKDIR /app

# --- dependency layer ------------------------------------------------------------------------
COPY docker/requirements-common.txt \
     docker/requirements-override.txt \
     docker/requirements-cpu.txt \
     /app/requirements/

RUN uv pip install --system --no-cache \
      --override /app/requirements/requirements-override.txt \
      -r /app/requirements/requirements-cpu.txt

# --- application layer -----------------------------------------------------------------------
COPY docker/smoke.py /app/smoke.py
COPY src/ /app/src/

# manifests/env.sh sets CPU_ENTRYPOINT=/app/train_cpu.py and manifests/cpu-run.sh runs exactly
# that with no arguments, handing the configuration over as `docker run -e` variables.
# docker/entrypoint.py is the env->argv translation; the filename selects the backend.
COPY docker/entrypoint.py /app/train_cpu.py

# Thread counts are set by the run environment, not baked in: the CPU sweep varies them, and a
# value frozen here would silently pin one point of that sweep. See requirements-cpu.txt.
CMD ["python3", "/app/smoke.py"]
